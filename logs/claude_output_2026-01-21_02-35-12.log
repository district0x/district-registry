istory_votingTokenTotalSupply: Float\n  stakeHistory_stakerDntStaked: Float\n  stakeHistory_stakerVotingTokenBalance: Float\n  stakeHistory_stakedAmount: Float\n  stakeHistory_unstake_: Boolean\n}","new_string":"type StakeHistory {\n  regEntry_address: ID\n  stakeHistory_stakeId: ID\n  stakeHistory_staker: String\n  stakeHistory_stakedOn: Date\n  stakeHistory_dntTotalStaked: Float\n  stakeHistory_votingTokenTotalSupply: Float\n  stakeHistory_stakerDntStaked: Float\n  stakeHistory_stakerVotingTokenBalance: Float\n  stakeHistory_stakedAmount: Float\n  stakeHistory_unstake_: Boolean\n}\n\n# The Backroom Types\n\ntype CouncilSeat {\n  councilSeat_index: ID\n  councilSeat_mindId: String\n  councilSeat_name: String\n  councilSeat_philosophyHash: String\n  councilSeat_isImmutable: Boolean\n  councilSeat_isActive: Boolean\n  councilSeat_createdOn: Date\n  councilSeat_totalStaked: Float\n  councilSeat_stakePercentage: Float\n  councilSeat_stakedBy(staker: ID): Float\n}\n\ntype CouncilSeatList {\n  items: [CouncilSeat]\n  totalCount: Int\n  endCursor: ID\n  hasNextPage: Boolean\n}\n\ntype CouncilStake {\n  councilSeat_index: ID\n  councilStake_staker: String\n  councilStake_amount: Float\n  councilStake_stakedOn: Date\n  councilStake_blockNumber: Int\n  councilStake_unstake_: Boolean\n}\n\ntype CouncilStakeBalance {\n  councilSeat_index: ID\n  councilStakeBalance_staker: String\n  councilStakeBalance_balance: Float\n}\n\nenum ARIProposalType {\n  ariProposal_type_treasuryTransfer\n  ariProposal_type_bountyCreation\n  ariProposal_type_grantApproval\n  ariProposal_type_parameterChange\n  ariProposal_type_customAction\n}\n\nenum ARIProposalStatus {\n  ariProposal_status_pending\n  ariProposal_status_vetoPeriod\n  ariProposal_status_approved\n  ariProposal_status_vetoed\n  ariProposal_status_executed\n  ariProposal_status_cancelled\n}\n\ntype ARIProposal {\n  ariProposal_id: ID\n  ariProposal_proposalType: ARIProposalType\n  ariProposal_reasoningHash: String\n  ariProposal_councilWeightsHash: String\n  ariProposal_snapshotBlock: Int\n  ariProposal_vetoDeadline: Date\n  ariProposal_amount: Float\n  ariProposal_recipient: String\n  ariProposal_status: ARIProposalStatus\n  ariProposal_vetoStakeAgainst: Float\n  ariProposal_vetoPercentage: Float\n  ariProposal_proposer: String\n  ariProposal_createdOn: Date\n  ariProposal_executedOn: Date\n}\n\ntype ARIProposalList {\n  items: [ARIProposal]\n  totalCount: Int\n  endCursor: ID\n  hasNextPage: Boolean\n}\n\nenum BountyStatus {\n  bounty_status_open\n  bounty_status_assigned\n  bounty_status_completed\n  bounty_status_claimed\n}\n\ntype Bounty {\n  bounty_id: ID\n  bounty_metadataHash: String\n  bounty_reward: Float\n  bounty_token: String\n  bounty_deadline: Date\n  bounty_assignee: String\n  bounty_status: BountyStatus\n  bounty_createdOn: Date\n  bounty_completedOn: Date\n  bounty_claimedOn: Date\n}\n\ntype BountyList {\n  items: [Bounty]\n  totalCount: Int\n  endCursor: ID\n  hasNextPage: Boolean\n}\n\ntype Grant {\n  grant_id: ID\n  grant_recipient: String\n  grant_totalAmount: Float\n  grant_disbursed: Float\n  grant_remaining: Float\n  grant_vestingStart: Date\n  grant_vestingDuration: Int\n  grant_purposeHash: String\n  grant_token: String\n  grant_createdOn: Date\n}\n\ntype GrantList {\n  items: [Grant]\n  totalCount: Int\n  endCursor: ID\n  hasNextPage: Boolean\n}"}},{"tool_name":"Edit","tool_use_id":"toolu_01Q6aQoHkJug6bh1cG4X4sZP","tool_input":{"file_path":"/Users/bradymckenna/Documents/GitHub/district-registry/src/district_registry/server/graphql_resolvers.cljs","old_string":"(def Vote\n  {:vote/option vote->option-resolver\n   :vote/reward vote->reward-resolver\n   :vote/amount vote->amount-resolver\n   :vote/amount-from-staking vote->amount-from-staking-resolver})\n\n(def resolvers-map\n  {:Query Query\n   :Vote Vote\n   :Challenge Challenge\n   :District District\n   :DistrictList {:items district-list->items-resolver}\n   :ParamChange ParamChange\n   :ParamChangeList {:items param-change-list->items-resolver}})","new_string":"(def Vote\n  {:vote/option vote->option-resolver\n   :vote/reward vote->reward-resolver\n   :vote/amount vote->amount-resolver\n   :vote/amount-from-staking vote->amount-from-staking-resolver})\n\n;; ========================================\n;; The Backroom Resolvers\n;; ========================================\n\n;; Council Seat Queries\n\n(defn council-seat-query-resolver [_ {:keys [:index]}]\n  (db/get {:select [:*]\n           :from [:council-seats]\n           :where [:= :council-seat/index index]}))\n\n(defn search-council-seats-query-resolver [_ {:keys [:only-active :order-by :order-dir :first :after]\n                                               :or {order-dir :asc}\n                                               :as args}]\n  (log/debug \"search-council-seats-query-resolver\" args)\n  (try-catch-throw\n    (let [page-start-idx (when after (parsers/parse-int after))\n          page-size first\n          query (cond-> {:select [:*]\n                         :from [:council-seats]}\n                  only-active (sqlh/merge-where [:= :council-seat/is-active true])\n                  order-by (sqlh/merge-order-by [[(get {:council-seats.order-by/index :council-seat/index\n                                                        :council-seats.order-by/total-staked :council-seat/total-staked\n                                                        :council-seats.order-by/created-on :council-seat/created-on}\n                                                       (graphql-utils/gql-name->kw order-by))\n                                                  order-dir]]))]\n      (paged-query query page-size page-start-idx))))\n\n;; ARI Proposal Queries\n\n(defn ari-proposal-query-resolver [_ {:keys [:id]}]\n  (db/get {:select [:*]\n           :from [:ari-proposals]\n           :where [:= :ari-proposal/id id]}))\n\n(defn search-ari-proposals-query-resolver [_ {:keys [:statuses :proposal-types :order-by :order-dir :first :after]\n                                               :or {order-dir :desc}\n                                               :as args}]\n  (log/debug \"search-ari-proposals-query-resolver\" args)\n  (try-catch-throw\n    (let [statuses-set (when statuses (set (map graphql-utils/gql-name->kw statuses)))\n          types-set (when proposal-types (set (map graphql-utils/gql-name->kw proposal-types)))\n          page-start-idx (when after (parsers/parse-int after))\n          page-size first\n          query (cond-> {:select [:*]\n                         :from [:ari-proposals]}\n                  statuses-set (sqlh/merge-where [:in :ari-proposal/status\n                                                  (mapv #(case %\n                                                          :ari-proposal.status/pending 0\n                                                          :ari-proposal.status/veto-period 1\n                                                          :ari-proposal.status/approved 2\n                                                          :ari-proposal.status/vetoed 3\n                                                          :ari-proposal.status/executed 5\n                                                          :ari-proposal.status/cancelled 6\n                                                          0) statuses-set)])\n                  types-set (sqlh/merge-where [:in :ari-proposal/proposal-type\n                                               (mapv #(case %\n                                                       :ari-proposal.type/treasury-transfer 0\n                                                       :ari-proposal.type/bounty-creation 1\n                                                       :ari-proposal.type/grant-approval 2\n                                                       :ari-proposal.type/parameter-change 3\n                                                       :ari-proposal.type/custom-action 4\n                                                       0) types-set)])\n                  order-by (sqlh/merge-order-by [[(get {:ari-proposals.order-by/created-on :ari-proposal/created-on\n                                                        :ari-proposals.order-by/veto-deadline :ari-proposal/veto-deadline\n                                                        :ari-proposals.order-by/veto-stake-against :ari-proposal/veto-stake-against}\n                                                       (graphql-utils/gql-name->kw order-by))\n                                                  order-dir]]))]\n      (paged-query query page-size page-start-idx))))\n\n;; Bounty Queries\n\n(defn bounty-query-resolver [_ {:keys [:id]}]\n  (db/get {:select [:*]\n           :from [:bounties]\n           :where [:= :bounty/id id]}))\n\n(defn search-bounties-query-resolver [_ {:keys [:statuses :order-by :order-dir :first :after]\n                                          :or {order-dir :desc}\n                                          :as args}]\n  (log/debug \"search-bounties-query-resolver\" args)\n  (try-catch-throw\n    (let [statuses-set (when statuses (set (map graphql-utils/gql-name->kw statuses)))\n          page-start-idx (when after (parsers/parse-int after))\n          page-size first\n          query (cond-> {:select [:*]\n                         :from [:bounties]}\n                  statuses-set (sqlh/merge-where [:in :bounty/status\n                                                  (mapv #(case %\n                                                          :bounty.status/open 0\n                                                          :bounty.status/assigned 1\n                                                          :bounty.status/completed 2\n                                                          :bounty.status/claimed 3\n                                                          0) statuses-set)])\n                  order-by (sqlh/merge-order-by [[(get {:bounties.order-by/created-on :bounty/created-on\n                                                        :bounties.order-by/deadline :bounty/deadline\n                                                        :bounties.order-by/reward :bounty/reward}\n                                                       (graphql-utils/gql-name->kw order-by))\n                                                  order-dir]]))]\n      (paged-query query page-size page-start-idx))))\n\n;; Grant Queries\n\n(defn grant-query-resolver [_ {:keys [:id]}]\n  (db/get {:select [:*]\n           :from [:grants]\n           :where [:= :grant/id id]}))\n\n(defn search-grants-query-resolver [_ {:keys [:recipient :order-by :order-dir :first :after]\n                                        :or {order-dir :desc}\n                                        :as args}]\n  (log/debug \"search-grants-query-resolver\" args)\n  (try-catch-throw\n    (let [page-start-idx (when after (parsers/parse-int after))\n          page-size first\n          query (cond-> {:select [:*]\n                         :from [:grants]}\n                  recipient (sqlh/merge-where [:= :grant/recipient recipient])\n                  order-by (sqlh/merge-order-by [[(get {:grants.order-by/created-on :grant/created-on\n                                                        :grants.order-by/total-amount :grant/total-amount}\n                                                       (graphql-utils/gql-name->kw order-by))\n                                                  order-dir]]))]\n      (paged-query query page-size page-start-idx))))\n\n;; Council Stake History\n\n(defn council-stake-history-resolver [_ {:keys [:seat-index :staker :from] :as args}]\n  (log/debug \"council-stake-history-resolver\" args)\n  (try-catch-throw\n    (db/all (cond-> {:select [:*]\n                     :from [:council-stakes]\n                     :order-by [[:council-stake/staked-on :desc]]}\n              seat-index (sqlh/merge-where [:= :council-seat/index seat-index])\n              staker (sqlh/merge-where [:= :council-stake/staker staker])\n              from (sqlh/merge-where [:>= :council-stake/staked-on from])))))\n\n(defn council-stake-balance-resolver [_ {:keys [:seat-index :staker]}]\n  (db/get {:select [:*]\n           :from [:council-stake-balances]\n           :where [:and\n                   [:= :council-seat/index seat-index]\n                   [:= :council-stake-balance/staker staker]]}))\n\n;; Field Resolvers\n\n(defn council-seat->stake-percentage [{:keys [:council-seat/total-staked]}]\n  (try-catch-throw\n    (let [total-council-stake (or (:sum (db/get {:select [[(sql/call :sum :council-seat/total-staked) :sum]]\n                                                  :from [:council-seats]\n                                                  :where [:= :council-seat/is-active true]}))\n                                  0)]\n      (if (zero? total-council-stake)\n        0\n        (* 100.0 (/ total-staked total-council-stake))))))\n\n(defn council-seat->staked-by [{:keys [:council-seat/index]} {:keys [:staker]}]\n  (let [{:keys [:council-stake-balance/balance]}\n        (db/get {:select [:*]\n                 :from [:council-stake-balances]\n                 :where [:and\n                         [:= :council-seat/index index]\n                         [:= :council-stake-balance/staker staker]]})]\n    (or balance 0)))\n\n(defn ari-proposal->veto-percentage [{:keys [:ari-proposal/veto-stake-against :ari-proposal/snapshot-block]}]\n  (try-catch-throw\n    (let [total-stake (or (:sum (db/get {:select [[(sql/call :sum :council-seat/total-staked) :sum]]\n                                          :from [:council-seats]\n                                          :where [:= :council-seat/is-active true]}))\n                          0)]\n      (if (zero? total-stake)\n        0\n        (* 100.0 (/ veto-stake-against total-stake))))))\n\n(defn ari-proposal->proposal-type [{:keys [:ari-proposal/proposal-type]}]\n  (enum (case proposal-type\n          0 :ari-proposal.type/treasury-transfer\n          1 :ari-proposal.type/bounty-creation\n          2 :ari-proposal.type/grant-approval\n          3 :ari-proposal.type/parameter-change\n          4 :ari-proposal.type/custom-action\n          :ari-proposal.type/custom-action)))\n\n(defn ari-proposal->status [{:keys [:ari-proposal/status]}]\n  (enum (case status\n          0 :ari-proposal.status/pending\n          1 :ari-proposal.status/veto-period\n          2 :ari-proposal.status/approved\n          3 :ari-proposal.status/vetoed\n          5 :ari-proposal.status/executed\n          6 :ari-proposal.status/cancelled\n          :ari-proposal.status/pending)))\n\n(defn bounty->status [{:keys [:bounty/status]}]\n  (enum (case status\n          0 :bounty.status/open\n          1 :bounty.status/assigned\n          2 :bounty.status/completed\n          3 :bounty.status/claimed\n          :bounty.status/open)))\n\n(defn grant->remaining [{:keys [:grant/total-amount :grant/disbursed]}]\n  (- total-amount disbursed))\n\n;; List Item Resolvers\n\n(defn council-seat-list->items-resolver [list]\n  (:items list))\n\n(defn ari-proposal-list->items-resolver [list]\n  (:items list))\n\n(defn bounty-list->items-resolver [list]\n  (:items list))\n\n(defn grant-list->items-resolver [list]\n  (:items list))\n\n;; ========================================\n;; Resolver Map Updates\n;; ========================================\n\n(def Query-extended\n  (merge Query\n    {:council-seat council-seat-query-resolver\n     :search-council-seats search-council-seats-query-resolver\n     :ari-proposal ari-proposal-query-resolver\n     :search-a-r-i-proposals search-ari-proposals-query-resolver\n     :bounty bounty-query-resolver\n     :search-bounties search-bounties-query-resolver\n     :grant grant-query-resolver\n     :search-grants search-grants-query-resolver\n     :council-stake-history council-stake-history-resolver\n     :council-stake-balance council-stake-balance-resolver}))\n\n(def CouncilSeat\n  {:council-seat/stake-percentage council-seat->stake-percentage\n   :council-seat/staked-by council-seat->staked-by})\n\n(def ARIProposal\n  {:ari-proposal/proposal-type ari-proposal->proposal-type\n   :ari-proposal/status ari-proposal->status\n   :ari-proposal/veto-percentage ari-proposal->veto-percentage})\n\n(def Bounty\n  {:bounty/status bounty->status})\n\n(def Grant\n  {:grant/remaining grant->remaining})\n\n(def resolvers-map\n  {:Query Query-extended\n   :Vote Vote\n   :Challenge Challenge\n   :District District\n   :DistrictList {:items district-list->items-resolver}\n   :ParamChange ParamChange\n   :ParamChangeList {:items param-change-list->items-resolver}\n   :CouncilSeat CouncilSeat\n   :CouncilSeatList {:items council-seat-list->items-resolver}\n   :ARIProposal ARIProposal\n   :ARIProposalList {:items ari-proposal-list->items-resolver}\n   :Bounty Bounty\n   :BountyList {:items bounty-list->items-resolver}\n   :Grant Grant\n   :GrantList {:items grant-list->items-resolver}})"}},{"tool_name":"Bash","tool_use_id":"toolu_01NfYeazCRd4WhKK3fQ4nM3j","tool_input":{"command":"cat >> /Users/bradymckenna/Documents/GitHub/district-registry/src/district_registry/server/graphql_resolvers.cljs << 'RESOLVERS_EOF'\n\n;; ========================================\n;; The Backroom Resolvers\n;; ========================================\n\n;; Council Seat Queries\n(defn council-seat-query-resolver [_ {:keys [:index]}]\n  (db/get {:select [:*]\n           :from [:council-seats]\n           :where [:= :council-seat/index index]}))\n\n(defn search-council-seats-query-resolver [_ {:keys [:only-active :order-by :order-dir :first :after]\n                                               :or {order-dir :asc}}]\n  (let [page-start-idx (when after (parsers/parse-int after))\n        page-size first\n        query (cond-> {:select [:*]\n                       :from [:council-seats]}\n                only-active (sqlh/merge-where [:= :council-seat/is-active true])\n                order-by (sqlh/merge-order-by [[(get {:council-seats.order-by/index :council-seat/index\n                                                      :council-seats.order-by/total-staked :council-seat/total-staked\n                                                      :council-seats.order-by/created-on :council-seat/created-on}\n                                                     (graphql-utils/gql-name->kw order-by))\n                                                order-dir]]))]\n    (paged-query query page-size page-start-idx)))\n\n;; ARI Proposal Queries\n(defn ari-proposal-query-resolver [_ {:keys [:id]}]\n  (db/get {:select [:*]\n           :from [:ari-proposals]\n           :where [:= :ari-proposal/id id]}))\n\n(defn search-ari-proposals-query-resolver [_ {:keys [:statuses :proposal-types :order-by :order-dir :first :after]\n                                               :or {order-dir :desc}}]\n  (let [page-start-idx (when after (parsers/parse-int after))\n        page-size first\n        query (cond-> {:select [:*]\n                       :from [:ari-proposals]}\n                order-by (sqlh/merge-order-by [[(get {:ari-proposals.order-by/created-on :ari-proposal/created-on\n                                                      :ari-proposals.order-by/veto-deadline :ari-proposal/veto-deadline\n                                                      :ari-proposals.order-by/veto-stake-against :ari-proposal/veto-stake-against}\n                                                     (graphql-utils/gql-name->kw order-by))\n                                                order-dir]]))]\n    (paged-query query page-size page-start-idx)))\n\n;; Bounty/Grant Queries\n(defn bounty-query-resolver [_ {:keys [:id]}]\n  (db/get {:select [:*] :from [:bounties] :where [:= :bounty/id id]}))\n\n(defn search-bounties-query-resolver [_ {:keys [:order-by :order-dir :first :after] :or {order-dir :desc}}]\n  (paged-query {:select [:*] :from [:bounties]} first (when after (parsers/parse-int after))))\n\n(defn grant-query-resolver [_ {:keys [:id]}]\n  (db/get {:select [:*] :from [:grants] :where [:= :grant/id id]}))\n\n(defn search-grants-query-resolver [_ {:keys [:recipient :order-by :order-dir :first :after] :or {order-dir :desc}}]\n  (let [query (cond-> {:select [:*] :from [:grants]}\n                recipient (sqlh/merge-where [:= :grant/recipient recipient]))]\n    (paged-query query first (when after (parsers/parse-int after)))))\n\n;; Update resolvers-map\n(def resolvers-map-backroom\n  (merge resolvers-map\n    {:CouncilSeat {:council-seat/staked-by (fn [{:keys [:council-seat/index]} {:keys [:staker]}]\n                                              (or (:council-stake-balance/balance\n                                                    (db/get {:select [:*] :from [:council-stake-balances]\n                                                            :where [:and [:= :council-seat/index index]\n                                                                    [:= :council-stake-balance/staker staker]]})) 0))}\n     :ARIProposal {:ari-proposal/proposal-type (fn [{:keys [:ari-proposal/proposal-type]}]\n                                                  (enum (case proposal-type 0 :ari-proposal.type/treasury-transfer 1 :ari-proposal.type/bounty-creation 2 :ari-proposal.type/grant-approval 3 :ari-proposal.type/parameter-change 4 :ari-proposal.type/custom-action :ari-proposal.type/custom-action)))\n                   :ari-proposal/status (fn [{:keys [:ari-proposal/status]}]\n                                          (enum (case status 0 :ari-proposal.status/pending 1 :ari-proposal.status/veto-period 2 :ari-proposal.status/approved 3 :ari-proposal.status/vetoed 5 :ari-proposal.status/executed 6 :ari-proposal.status/cancelled :ari-proposal.status/pending)))}\n     :Bounty {:bounty/status (fn [{:keys [:bounty/status]}]\n                               (enum (case status 0 :bounty.status/open 1 :bounty.status/assigned 2 :bounty.status/completed 3 :bounty.status/claimed :bounty.status/open)))}\n     :Grant {:grant/remaining (fn [{:keys [:grant/total-amount :grant/disbursed]}] (- total-amount disbursed))}\n     :CouncilSeatList {:items :items}\n     :ARIProposalList {:items :items}\n     :BountyList {:items :items}\n     :GrantList {:items :items}}))\n\nRESOLVERS_EOF","description":"Append Backroom resolvers to file"}}],"uuid":"7fdd3d78-57e1-4311-9610-a8ab11f1d473"}
